rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRoles() {
      let data = userProfile();
      return ("roles" in data) ? data.roles : (("role" in data) ? [data.role] : []);
    }

    function isActive() {
      return userProfile().active != false;
    }

    function hasRole(role) {
      return signedIn() && isActive() && role in userRoles();
    }

    function isAdmin() {
      return hasRole("admin");
    }

    // El valor guardado sigue siendo "editor" (para no migrar cuentas ya
    // creadas); en la interfaz se muestra como "Staff". Puede modificar todo
    // el contenido excepto usuarios y accesos de creadores (eso queda
    // exclusivo de admin).
    function isStaff() {
      return hasRole("admin") || hasRole("editor");
    }

    function isStaffOrCreador() {
      return isStaff() || hasRole("creador");
    }

    function isCapitanDe(juego) {
      return (hasRole("capitan") || hasRole("segundocapitan")) && userProfile().equipoJuego == juego;
    }

    function isEquipoMiembro(juego) {
      return (hasRole("capitan") || hasRole("segundocapitan") || hasRole("jugador")) && userProfile().equipoJuego == juego;
    }

    match /users/{userId} {
      // isStaff() (no solo isAdmin()) puede LISTAR la colección completa:
      // lo necesita el Tablero para armar el selector de "Responsables" de
      // una tarea. Sigue sin poder crear/editar/borrar cuentas (eso es
      // exclusivo de admin, "staff... menos usuarios").
      allow read: if isStaff() || (signedIn() && request.auth.uid == userId);
      // twitchLogin ya NO se autogestiona con un write directo del cliente:
      // se verifica con OAuth contra la cuenta real de Twitch y lo escribe
      // el SDK de Admin desde twitchBotAuthCallback (bypassa estas reglas).
      // Esto evita que alguien escriba el canal de otra persona a mano.
      // fcmTokens (tokens de push de sus propios dispositivos) sí lo
      // autogestiona cada cuenta, sin poder tocar ningún otro campo.
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["fcmTokens", "notifPrefs"])
      );
      allow create, delete: if isAdmin();
    }

    // El creador vinculado (streamers/{doc}.uid == su propio uid) puede
    // editar descripcion, sus redes y sus juegos desde el Portal Creadores —
    // imagen, nombre, horario, etc. siguen siendo exclusivos de staff.
    function isLinkedCreador(streamerData) {
      return hasRole("creador") && ("uid" in streamerData) && streamerData.uid == request.auth.uid;
    }

    match /streamers/{doc} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff() ||
        (isLinkedCreador(resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly([
             "descripcion", "instagram", "twitch", "kick", "tiktok", "discord", "juegosManual",
             "avatarOverride", "bannerOverride", "fraseCorta", "paletaColores",
             "canalesSecundarios", "mensajesActivo", "moderacion", "updatedAt"
           ]));

      // Historial de encendidos/apagados de stream (lo escribe solo el
      // webhook de Twitch con el Admin SDK, que no pasa por estas reglas).
      // Nadie puede escribirlo desde el cliente; solo staff y la propia
      // cuenta vinculada pueden leerlo — es dato de cumplimiento de
      // contrato, no algo público.
      match /transmisiones/{sessionId} {
        allow read: if isStaff() ||
          (signedIn() && get(/databases/$(database)/documents/streamers/$(doc)).data.uid == request.auth.uid);
        allow write: if false;

        // Conteo de mensajes por persona (Sello de Audiencia Real) — nunca
        // el texto de lo que escribió, solo cuántos mensajes y cuándo.
        // Mismo criterio de lectura que la sesión misma; lo escribe solo
        // el webhook de chat de Twitch con el Admin SDK.
        match /chatters/{chatterId} {
          allow read: if isStaff() ||
            (signedIn() && get(/databases/$(database)/documents/streamers/$(doc)).data.uid == request.auth.uid);
          allow write: if false;
        }
      }

      // El email de contacto vive acá, no en el doc público (que tiene
      // allow read: if true para las tarjetas). Solo staff lo puede ver o
      // escribir, evitando que cualquiera lea emails vía una consulta
      // directa a Firestore.
      match /privado/{sub} {
        allow read, write: if isStaff();
      }

      // Visitas al perfil público, un doc por día (registrarVisitaPerfil,
      // Admin SDK). Nunca IPs ni nada identificable del visitante — solo un
      // conteo. Mismo criterio de lectura que transmisiones/chatters.
      match /visitas/{fecha} {
        allow read: if isStaff() ||
          (signedIn() && get(/databases/$(database)/documents/streamers/$(doc)).data.uid == request.auth.uid);
        allow write: if false;
      }

      // Ranking público de "Fans más activos" del perfil (registrarFanActivo,
      // Admin SDK) — a diferencia de transmisiones/chatters, esto SÍ es
      // público a propósito: es un agregado de por vida (login + total de
      // mensajes, nada de horarios ni datos de sesión) de algo que ya es
      // público de por sí (quién escribe en el chat de Twitch lo ve
      // cualquiera ahí mismo).
      match /fansActivos/{chatterId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /rosters/{doc} {
      allow read: if true;
      allow create: if isStaff() || isCapitanDe(request.resource.data.juego);
      allow update, delete: if isStaff() ||
        (isCapitanDe(resource.data.juego) && request.resource.data.juego == resource.data.juego);
    }

    match /equipoActividad/{doc} {
      allow read: if isStaff() || resource.data.visiblePublico == true || isEquipoMiembro(resource.data.juego);
      allow create: if isStaff() || isCapitanDe(request.resource.data.juego);
      allow update, delete: if isStaff() ||
        (isCapitanDe(resource.data.juego) && request.resource.data.juego == resource.data.juego);
    }

    // Mismo criterio que isLinkedCreador: el influencer vinculado
    // (influencers/{doc}.uid == su propio uid) puede personalizar su tarjeta
    // (descripción, frase corta, paleta de colores, avatar/banner propios y
    // sus links de Instagram/TikTok) desde su portal — nombre, categoría y
    // país siguen siendo exclusivos de staff.
    function isLinkedInfluencer(influencerData) {
      return hasRole("influencer") && ("uid" in influencerData) && influencerData.uid == request.auth.uid;
    }

    match /influencers/{doc} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff() ||
        (isLinkedInfluencer(resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly([
             "descripcion", "instagram", "tiktok", "fraseCorta", "paletaColores",
             "avatarOverride", "bannerOverride", "updatedAt"
           ]));

      match /privado/{sub} {
        allow read, write: if isStaff();
      }

      // Mismo ranking público de "Fans más activos" que streamers/{doc} —
      // solo aplica si el influencer tiene Twitch conectado (ver
      // registrarFanActivo).
      match /fansActivos/{chatterId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /staff/{doc} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /sponsors/{doc} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /overlayConfig/{doc} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /overlayComandos/{doc} {
      allow read: if true;
      allow write: if isStaff();
      // Cada creador puede administrar sus propios comandos, exclusivos de
      // su canal (canal == su twitchLogin verificado por OAuth), además de
      // los generales que carga el staff (esos no tienen campo canal).
      // Nunca puede tocar un comando de otro canal ni "globalizar" el
      // propio vaciando/cambiando canal.
      allow create: if hasRole("creador") &&
        request.resource.data.canal is string && request.resource.data.canal.size() > 0 &&
        request.resource.data.canal == userProfile().twitchLogin;
      allow update: if hasRole("creador") &&
        resource.data.canal == userProfile().twitchLogin &&
        request.resource.data.canal == resource.data.canal;
      allow delete: if hasRole("creador") && resource.data.canal == userProfile().twitchLogin;
    }

    // Layout personalizado del overlay (posición de logo/redes/banner de
    // comando/banner de raid) por canal, doc id == twitchLogin verificado.
    // Lectura pública: la lee el propio overlay en OBS, sin sesión. Se deja
    // leer siempre en true por la misma razón que overlayEventoActual y
    // raidAlerts (OBS no puede autenticarse) — no expone nada sensible, son
    // solo coordenadas.
    match /overlayLayout/{doc} {
      allow read: if true;
      allow write: if isStaff() || (hasRole("creador") && doc == userProfile().twitchLogin);
    }

    match /overlayCodigos/{doc} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Evento actual disparado por un comando de chat (banner tipo noticiero
    // en el overlay), un doc por canal de Twitch: solo lo escribe el Admin
    // SDK desde twitchChatWebhook. "_general" es la excepción: un mensaje
    // para TODOS los streams a la vez, que sí puede escribir el staff
    // directo desde el admin (sin pasar por una Cloud Function).
    match /overlayEventoActual/{doc} {
      allow read: if true;
      allow write: if doc == "_general" && isStaff();
    }

    match /proyectos/{doc} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Reportes de bug/feedback: botón flotante en todas las páginas
    // (público y logueado). Cualquiera puede crear uno; solo staff los lee.
    match /reportes/{doc} {
      function isValidReporte() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            "mensaje", "capturaUrl", "pagina", "email", "userAgent", "estado", "createdAt"
          ])
          && data.mensaje is string && data.mensaje.size() > 0 && data.mensaje.size() < 3000
          && data.estado == "nuevo";
      }

      allow create: if isValidReporte();
      allow read, update, delete: if isStaff();
    }

    match /mensajes/{doc} {
      function isValidMensaje() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            "nombre", "email", "asunto", "mensaje", "leido", "createdAt",
            "juego", "nivel", "id_juego", "redes", "descripcion", "equipo", "juego_torneo"
          ])
          && data.nombre is string && data.nombre.size() > 0 && data.nombre.size() < 200
          && data.email is string && data.email.size() > 0 && data.email.size() < 200
          && data.asunto is string && data.asunto.size() < 100
          && data.mensaje is string && data.mensaje.size() > 0 && data.mensaje.size() < 5000
          && data.leido == false;
      }

      allow create: if isValidMensaje();
      allow read, update, delete: if isStaff();
    }

    // Mensajes que le escriben a un streamer desde su perfil público (no
    // desde el formulario de contacto general de arriba) — el emisor no
    // necesita cuenta, el destinatario sí necesita tener mensajesActivo
    // para que su perfil muestre el formulario (ver streamer.html). Nunca
    // se expone el email del streamer en este flujo.
    match /mensajesPerfil/{doc} {
      function isValidMensajePerfil() {
        let data = request.resource.data;
        return data.keys().hasOnly(["streamerId", "nombreRemitente", "emailRemitente", "mensaje", "leido", "createdAt"])
          && data.streamerId is string && data.streamerId.size() > 0
          && data.nombreRemitente is string && data.nombreRemitente.size() > 0 && data.nombreRemitente.size() < 100
          && data.mensaje is string && data.mensaje.size() > 0 && data.mensaje.size() < 3000
          && data.leido == false;
      }

      allow create: if isValidMensajePerfil();
      allow read: if isStaff() ||
        (signedIn() && get(/databases/$(database)/documents/streamers/$(resource.data.streamerId)).data.uid == request.auth.uid);
      allow update: if isStaff() ||
        (signedIn() && get(/databases/$(database)/documents/streamers/$(resource.data.streamerId)).data.uid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["leido"]));
      allow delete: if isStaff() ||
        (signedIn() && get(/databases/$(database)/documents/streamers/$(resource.data.streamerId)).data.uid == request.auth.uid);
    }

    // "accesos" son los permisos/torneos exclusivos de creadores: queda
    // admin-only a propósito (es "datos de creadores", excluido de staff).
    match /accesos/{doc} {
      allow read: if isStaffOrCreador();
      allow write: if isAdmin();
    }

    // Tablero de ideas y tareas: herramienta interna del equipo de staff.
    match /ideas/{doc} {
      allow read, write: if isStaff();
    }

    match /tareas/{doc} {
      allow read, write: if isStaff();
    }

    // Voranix Rivals: temporada competitiva entre 2 Alianzas. Lectura pública
    // (es la página de resultados en vivo), pero la carga de equipos/puntajes
    // queda exclusiva de admin (ni Staff), a pedido explícito del usuario.
    match /alianzas/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rivalsPuntos/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rivalsActividades/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rivalsConfig/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Alertas de raid de Twitch para el overlay: solo las escribe el Admin
    // SDK desde la Cloud Function del webhook de EventSub, nunca un cliente.
    match /raidAlerts/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Sello de Audiencia Real: el sello en sí es público (es lo que se
    // muestra en la tarjeta del streamer), pero todo lo que se usa para
    // calcularlo es exclusivo del Admin SDK — ni siquiera staff lo lee
    // desde el cliente, no hay ninguna vista que lo necesite.
    match /sellos/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /twitchUsuariosCache/{doc} {
      allow read, write: if false;
    }
    match /chatterCanales/{doc} {
      allow read, write: if false;
    }

    // Qué canales autorizaron al bot: los docs por canal (broadcasterId,
    // broadcasterLogin, authorizedAt) no tienen nada sensible y se dejan
    // leer para que el Portal Creadores muestre "tu canal ya está
    // conectado". El doc "_bot" sí tiene el token del bot y queda bloqueado.
    // La escritura siempre queda exclusiva del Admin SDK (viene de un OAuth
    // real contra Twitch, nunca de un cliente).
    match /twitchBotAuth/{doc} {
      allow read: if doc != "_bot";
      allow write: if false;

      // Access/refresh token del propio streamer (moderator:read:followers),
      // igual de sensible que el token del bot en "_bot": nadie lo lee ni lo
      // escribe desde el cliente, ni siquiera su dueño ni un admin — solo el
      // Admin SDK de las Cloud Functions, que bypasea estas reglas.
      match /privado/{sub} {
        allow read, write: if false;
      }
    }

    // Igual patrón que twitchBotAuth de acá arriba, para YouTube y Kick:
    // el doc público (channelId/slug, title, authorizedAt) se deja leer
    // para el Portal Creadores; los tokens van aparte y bloqueados.
    match /youtubeAuth/{doc} {
      allow read: if true;
      allow write: if false;

      match /privado/{sub} {
        allow read, write: if false;
      }
    }

    match /kickAuth/{doc} {
      allow read: if true;
      allow write: if false;

      match /privado/{sub} {
        allow read, write: if false;
      }
    }

    match /tiktokAuth/{doc} {
      allow read: if true;
      allow write: if false;

      match /privado/{sub} {
        allow read, write: if false;
      }
    }

    match /instagramAuth/{doc} {
      allow read: if true;
      allow write: if false;

      match /privado/{sub} {
        allow read, write: if false;
      }
    }

    // A diferencia de youtubeAuth/kickAuth/tiktokAuth de acá arriba, nada del
    // cliente necesita leer este doc directo — Portal Creadores muestra el
    // estado de Discord a partir de users/{uid}.discordUserId y de
    // streamers/{doc}.discordGuildId/discordRoleId, ambos ya cubiertos por
    // sus propias reglas. Se deja completamente cerrado, como twitchBotAuth.
    match /discordAuth/{doc} {
      allow read, write: if false;

      match /privado/{sub} {
        allow read, write: if false;
      }
    }

    // Estado temporal de PKCE del login de Kick/TikTok (vive segundos, entre
    // el redirect a la plataforma y que vuelva al callback) — nadie necesita
    // leerlo ni escribirlo desde el cliente, solo el Admin SDK de esas
    // funciones.
    match /kickPkce/{doc} {
      allow read, write: if false;
    }

    match /tiktokPkce/{doc} {
      allow read, write: if false;
    }

    // Centro de notificaciones (campanita en los 3 portales): un doc por
    // aviso, siempre dirigido a un solo uid. Las escribe el SDK de Admin
    // desde las Cloud Functions que detectan el cambio (tareas asignadas,
    // actividad de equipo publicada, accesos/proyectos nuevos, etc.); el
    // cliente solo puede leer las suyas y marcarlas como leídas.
    match /notificaciones/{doc} {
      allow read: if signedIn() && resource.data.paraUid == request.auth.uid;
      allow update: if signedIn() && resource.data.paraUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["leido"]);
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
