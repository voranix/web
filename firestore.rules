rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /streamers/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rosters/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sponsors/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /proyectos/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
