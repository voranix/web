rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }

    function isStaffOrCreador() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active != false &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'editor', 'creador'];
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    match /streamers/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rosters/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /influencers/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /staff/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sponsors/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /proyectos/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mensajes/{doc} {
      function isValidMensaje() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            "nombre", "email", "asunto", "mensaje", "leido", "createdAt",
            "juego", "nivel", "id_juego", "redes", "descripcion", "equipo", "juego_torneo"
          ])
          && data.nombre is string && data.nombre.size() > 0 && data.nombre.size() < 200
          && data.email is string && data.email.size() > 0 && data.email.size() < 200
          && data.asunto is string && data.asunto.size() < 100
          && data.mensaje is string && data.mensaje.size() > 0 && data.mensaje.size() < 5000
          && data.leido == false;
      }

      allow create: if isValidMensaje();
      allow read, update, delete: if isAdmin();
    }

    match /accesos/{doc} {
      allow read: if isStaffOrCreador();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
