rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRoles() {
      let data = userProfile();
      return ("roles" in data) ? data.roles : (("role" in data) ? [data.role] : []);
    }

    function isActive() {
      return userProfile().active != false;
    }

    function hasRole(role) {
      return signedIn() && isActive() && role in userRoles();
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isStaffOrCreador() {
      return hasRole("admin") || hasRole("editor") || hasRole("creador");
    }

    function isCapitanDe(juego) {
      return hasRole("capitan") && userProfile().equipoJuego == juego;
    }

    function isEquipoMiembro(juego) {
      return (hasRole("capitan") || hasRole("jugador")) && userProfile().equipoJuego == juego;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    match /streamers/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rosters/{doc} {
      allow read: if true;
      allow create: if isAdmin() || isCapitanDe(request.resource.data.juego);
      allow update, delete: if isAdmin() ||
        (isCapitanDe(resource.data.juego) && request.resource.data.juego == resource.data.juego);
    }

    match /equipoActividad/{doc} {
      allow read: if resource.data.visiblePublico == true || isEquipoMiembro(resource.data.juego) || isAdmin();
      allow create: if isAdmin() || isCapitanDe(request.resource.data.juego);
      allow update, delete: if isAdmin() ||
        (isCapitanDe(resource.data.juego) && request.resource.data.juego == resource.data.juego);
    }

    match /influencers/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /staff/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sponsors/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /overlayConfig/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /proyectos/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mensajes/{doc} {
      function isValidMensaje() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            "nombre", "email", "asunto", "mensaje", "leido", "createdAt",
            "juego", "nivel", "id_juego", "redes", "descripcion", "equipo", "juego_torneo"
          ])
          && data.nombre is string && data.nombre.size() > 0 && data.nombre.size() < 200
          && data.email is string && data.email.size() > 0 && data.email.size() < 200
          && data.asunto is string && data.asunto.size() < 100
          && data.mensaje is string && data.mensaje.size() > 0 && data.mensaje.size() < 5000
          && data.leido == false;
      }

      allow create: if isValidMensaje();
      allow read, update, delete: if isAdmin();
    }

    match /accesos/{doc} {
      allow read: if isStaffOrCreador();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
