rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function hasValidRole() {
      return signedIn()
        && userDoc().data.active != false
        && userDoc().data.role in ['admin', 'editor'];
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if hasValidRole();
    }
  }
}
