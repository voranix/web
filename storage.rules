rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userRoles() {
      let data = userDoc().data;
      return ("roles" in data) ? data.roles : (("role" in data) ? [data.role] : []);
    }

    function hasValidRole() {
      return signedIn()
        && userDoc().data.active != false
        && userRoles().hasAny(['admin', 'editor']);
    }

    // Capturas del botón de "Reportar un problema": cualquiera puede subir
    // una (público, sin login), acotado a imágenes chicas para evitar abuso.
    // La lectura queda pública (mismo criterio que el resto de las imágenes
    // del sitio): restringirla a staff rompería el <img> del admin, que
    // muestra la captura con una URL simple, no vía el SDK autenticado.
    // La URL en sí no es adivinable (trae un token largo de Firebase), así
    // que en la práctica solo la ve quien la sube o quien la abre desde el
    // panel de admin.
    match /reportes/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    // Avatar/banner que el propio streamer sube desde Mi Tarjeta (Portal
    // Creadores). Acotado a su propio streamerId (verificado contra su uid
    // real en Firestore, no algo que el cliente pueda falsear) y a los
    // límites de tamaño que ya se muestran en la UI.
    function esCreadorDe(streamerId) {
      return signedIn() &&
        firestore.get(/databases/(default)/documents/streamers/$(streamerId)).data.uid == request.auth.uid;
    }
    match /streamerAvatares/{streamerId}/{fileName} {
      allow read: if true;
      allow write: if esCreadorDe(streamerId) &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches("image/.*");
    }
    match /streamerBanners/{streamerId}/{fileName} {
      allow read: if true;
      allow write: if esCreadorDe(streamerId) &&
        request.resource.size < 4 * 1024 * 1024 &&
        request.resource.contentType.matches("image/.*");
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if hasValidRole();
    }
  }
}
