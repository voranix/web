rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userRoles() {
      let data = userDoc().data;
      return ("roles" in data) ? data.roles : (("role" in data) ? [data.role] : []);
    }

    function hasValidRole() {
      return signedIn()
        && userDoc().data.active != false
        && userRoles().hasAny(['admin', 'editor']);
    }

    // Capturas del botón de "Reportar un problema": cualquiera puede subir
    // una (público, sin login), acotado a imágenes chicas para evitar abuso.
    match /reportes/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if hasValidRole();
    }
  }
}
