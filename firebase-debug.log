[debug] [2026-06-18T23:00:01.071Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/voranix-2ecc9/rulesets {"name":"projects/voranix-2ecc9/rulesets/06e236a6-caf6-46b8-a8b7-3255769274e8","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isAdmin() {\n      return signedIn() &&\n        get(\n          /databases/$(database)/documents/users/$(request.auth.uid)\n        ).data.role == \"admin\";\n    }\n\n    match /users/{userId} {\n      allow read: if signedIn();\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /streamers/{doc} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /rosters/{doc} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /sponsors/{doc} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /proyectos/{doc} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /{document=**} {\n      allow read, write: if isAdmin();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-06-18T23:00:00.793007Z","metadata":{"services":["cloud.firestore"]}}
